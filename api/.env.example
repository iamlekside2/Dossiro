# =============================================================================
# Dossiro API
# Copy to .env and fill in. Never commit .env.
# =============================================================================

NODE_ENV=development
PORT=4010
API_BASE_URL=http://localhost:4010
WEB_BASE_URL=http://localhost:3015
# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3015

# ---------- Database (PostgreSQL 15+) ----------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dossiro?schema=public"

# ---------- Auth ----------
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-change-me-at-least-16-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Signs the short-lived tickets that authorise a share download.
TICKET_SECRET=dev-change-me-at-least-16-chars
TICKET_TTL_SECONDS=300

# ---------- Storage ----------
# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
MAX_UPLOAD_BYTES=209715200

S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------- Sharing & retention ----------
# Applied when a share is created without an explicit expiry (feature 1).
DEFAULT_SHARE_TTL_HOURS=168
# Days a soft-deleted item stays recoverable before purge is allowed (feature 24).
RECYCLE_BIN_DAYS=30

# ---------- Queue ----------
# Leave blank to run jobs in-process. Set for real async processing (features 1, 3, 15).
# REDIS_URL=redis://localhost:6379
REDIS_URL=

# ---------- WhatsApp (Meta WhatsApp Cloud API) ----------
# https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_VERSION=v21.0
# Any string; paste the same value into the Meta webhook configuration screen.
WHATSAPP_VERIFY_TOKEN=
# App secret, used to verify the X-Hub-Signature-256 header on every webhook.
WHATSAPP_APP_SECRET=

# ---------- Email ----------
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Dossiro <no-reply@dossiro.com>"
# Shared secret your inbound-mail provider appends to the webhook URL:
#   https://api.example.com/api/channels/email/inbound?secret=<value>
EMAIL_INBOUND_SECRET=

# ---------- AI (features 5, 15, 19) ----------
# anthropic | none
AI_PROVIDER=none
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# ---------- External processing services ----------
# Python OCR sidecar (feature 1)
OCR_SERVICE_URL=
# Gotenberg for batch document -> PDF conversion (feature 3)
GOTENBERG_URL=
# OnlyOffice Document Server for live co-editing (features 20, 22)
ONLYOFFICE_URL=
