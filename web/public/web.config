<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for the Dossiro workbench.

  Two jobs. It proxies /api to the Node process so the browser talks to one
  origin — which matters here beyond tidiness, because the tenancy is resolved
  from the Host header before sign-in, and a separate API origin would hand the
  API its own hostname instead of the tenant's.

  And it falls back to index.html, because the workbench routes in the browser:
  a reload on /repository is a real request for a file IIS does not have.

  Vite copies everything in public/ into dist/, so this ships with the build.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Must come first: the SPA fallback below would otherwise swallow
             every API call and answer it with the HTML page, which arrives at
             the client as "Unexpected token '<'" and looks like a broken API. -->
        <rule name="ApiProxy" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:4010/api/{R:1}" />
          <serverVariables>
            <!-- The API reads the Host header to decide which tenant is being
                 addressed (TEN-2). Without this, ARR rewrites it to
                 127.0.0.1:4010 and every request looks like it arrived at a
                 hostname no tenant owns. -->
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
            <set name="HTTP_X_FORWARDED_PROTO" value="{REQUEST_SCHEME}" />
          </serverVariables>
        </rule>

        <!-- Public share links are served by the API, not the SPA. -->
        <rule name="PublicShareProxy" stopProcessing="true">
          <match url="^public/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:4010/api/public/{R:1}" />
        </rule>

        <rule name="SpaFallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <!-- Documents can be large, and the default IIS request cap is 30MB. This
         matches MAX_UPLOAD_BYTES; raising one without the other produces a
         failure at a size the application says it allows. -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="104857600" />
      </requestFiltering>
    </security>

    <staticContent>
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
